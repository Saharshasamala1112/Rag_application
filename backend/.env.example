# Server
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true
API_KEY=replace-with-a-long-random-secret
ENV=development
LOG_LEVEL=INFO

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_PREDICT=2048

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Reranker
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=8

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Retrieval
RETRIEVAL_TOP_K=12
FINAL_TOP_K=5

# Upload
UPLOAD_DIR=data/uploads
MAX_FILE_SIZE_MB=50
MAX_PDF_PAGES=500
MAX_DOCX_XML_MB=20
MAX_DOCUMENT_ARCHIVE_MB=100
MAX_TABULAR_FILE_MB=10
MAX_CONCURRENT_DOCUMENT_PROCESSING=4
EXTERNAL_PARSER_TIMEOUT_SECONDS=10
